{
  "name": "signalk-openwakeword",
  "version": "0.1.0",
  "description": "Wyoming openWakeWord wake word detection service for Signal K — runs rhasspy/wyoming-openwakeword in a managed container.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run typecheck:test && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "prettier": "prettier --write .",
    "lint": "eslint --fix",
    "format": "npm run prettier && npm run lint",
    "ci-lint": "eslint && prettier --check .",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility",
    "wyoming",
    "openwakeword",
    "wake-word",
    "voice",
    "marine"
  ],
  "author": "hoeken",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoeken/signalk-openwakeword.git"
  },
  "signalk": {
    "displayName": "openWakeWord (Wyoming)",
    "requires": [
      "signalk-container"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "signalk-container-helper": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@signalk/server-api": "^2.30.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "signalk-wyoming": "file:../signalk-wyoming",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.10"
  }
}
