{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"],
  // The webapp is a browser bundle built by vite, not part of dist/. It is
  // typechecked separately (tsconfig.webapp.json) so it gets DOM libs instead
  // of Node ones — and so `tsc` never emits it into dist/.
  "exclude": ["src/webapp"]
}
